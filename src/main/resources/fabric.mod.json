{
  "schemaVersion": 1,
  "id": "more_enchanted",
  "version": "${version}",
  "name": "More Enchanted",
  "description": "Expands Minecraft 26.3 with 12 wilderness-themed enchantments, dynamic combat, foraging bonuses, and full Enchanted Books support.",
  "authors": [
    {
      "name": "modclaim"
    }
  ],
  "contact": {
    "homepage": "https://github.com/modclaim/more-enchanted",
    "sources": "https://github.com/modclaim/more-enchanted",
    "issues": "https://github.com/modclaim/more-enchanted/issues"
  },
  "license": "MIT",
  "icon": "assets/more_enchanted/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.moreenchanted.MoreEnchanted"
    ]
  },
  "mixins": [
    "more_enchanted.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.3",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.sources": "https://github.com/modclaim/more-enchanted",
        "modmenu.issues": "https://github.com/modclaim/more-enchanted/issues"
      }
    }
  }
}
